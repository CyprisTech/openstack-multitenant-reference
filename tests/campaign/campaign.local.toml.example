# The maintainers' configuration of a campaign: copy to campaign.local.toml (git-ignored).
# Nothing here is versioned: names and addresses of the test cloud stay on the maintainers' side.

tool    = "tofu"            # or "terraform"
ca_cert = ""                # CA bundle of the cloud APIs, when they use a private authority
site     = "t1"             # prefix of the names
ssh_user = "ops"
ssh_key  = "~/.ssh/id_ed25519"
test_zone = "example.org"   # the zone of the test names (site-a, site-b, apps.published, services)
# clouds_yaml = "~/.config/openstack/clouds.yaml"
# notify_hook = "/path/to/notify"   # tells the operator: revocation awaited, campaign stopped
# repair_hook = "/path/to/repair"   # repairs a known failure of your cloud, prints extra apply arguments
# repairs     = 1

# The clouds.yaml entry of each stack's project, by stack key of the scenario.
[clouds]
planes           = "my-hub"
receiver         = "my-shared-services"
acme             = "my-shared-services"
internal-service = "my-shared-services"
entry-point      = "my-edge"
vm               = "my-web"
isolated         = "my-isolated"
shared           = "my-k8s-shared"
published        = "my-published"

# The application credentials handed to the clusters (clouds.yaml entries).
[cluster_clouds]
published = "my-published-cluster"
shared    = "my-k8s-shared-cluster"

# The planes of each mode, as the planes map of stacks/shared/planes.
[planes.gateway]
publication   = { mode = "gateway", cidr = "192.0.2.0/24", network = "public-services", subnet = "public-services-subnet" }
observability = { mode = "gateway", cidr = "198.51.100.0/24", network = "monitoring", subnet = "monitoring-subnet" }
internal      = { mode = "gateway", cidr = "203.0.113.0/24", network = "intranet", subnet = "intranet-subnet" }

[planes.interface]
publication   = { mode = "interface", cidr = "172.31.0.0/24" }
observability = { mode = "interface", cidr = "172.31.1.0/24" }
internal      = { mode = "gateway", cidr = "203.0.113.0/24", network = "intranet", subnet = "intranet-subnet" }
