# Copy to tests/campaign/campaign.env (git-ignored) and adapt.
# Each stack and fixture also needs its terraform.tfvars, made from terraform.tfvars.example. On a
# small cloud, set control_plane_count = 1 in the cluster of the two Kubernetes stacks.

# clouds.yaml entries, one project per stack
CLOUD_HUB=my-hub
CLOUD_SHARED=my-shared-services
CLOUD_EDGE=my-edge
CLOUD_WEB=my-web
CLOUD_ISOLATED=my-isolated
CLOUD_PUBLISHED=my-published
CLOUD_K8S_SHARED=my-k8s-shared
# Application credentials handed to the clusters
CLOUD_PUBLISHED_CLUSTER=my-published-cluster
CLOUD_K8S_SHARED_CLUSTER=my-k8s-shared-cluster

# Credential the shared cluster moves to (step rotate), and the upgrade (step upgrade): deploy the
# shared cluster with the previous minor version, and name the next one here
CLOUD_K8S_SHARED_CLUSTER_NEXT=my-k8s-shared-cluster-2
UPGRADE_VERSION=v1.36.5
UPGRADE_IMAGE=ubuntu-2404-kube-v1.36.5

SITE=t1
SSH_USER=ops
SSH_KEY=$HOME/.ssh/id_ed25519
# CA bundle of the cloud API, when it is private
CA_CERT=

# The planes, as lines of the planes map of stacks/shared/planes
PLANES_GATEWAY='  publication   = { mode = "gateway", cidr = "192.0.2.0/24", network = "public-services", subnet = "public-services-subnet" }
  observability = { mode = "gateway", cidr = "198.51.100.0/24", network = "monitoring", subnet = "monitoring-subnet" }
  internal      = { mode = "gateway", cidr = "203.0.113.0/24", network = "intranet", subnet = "intranet-subnet" }'
PLANES_INTERFACE='  publication   = { mode = "interface", cidr = "172.31.0.0/24" }
  observability = { mode = "interface", cidr = "172.31.1.0/24" }
  internal      = { mode = "gateway", cidr = "203.0.113.0/24", network = "intranet", subnet = "intranet-subnet" }'
# Address of the transit router on the observability plane (interface mode, step hostile)
HOSTILE_NEXT_HOP=172.31.1.1

# Optional
# RECORD=1                         # one asciinema recording per step, in <work>/casts
# CONSUMER_CIDR=203.0.113.10/32    # this machine, as the shared cluster sees it (step consumer)
# CAPTURE_REPLACE="--replace real.example=example.org"
# REPAIR_HOOK=/path/to/repair      # repairs a known failure of your cloud, prints extra apply arguments
# REPAIRS=1
# WORK=/path/to/work               # default tests/campaign/work
