# Local .terraform directories and lock files
.terraform/
.terraform.lock.hcl

# State and plan files: never commit them, they contain secrets and infrastructure details
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.json

# Variable files may contain secrets and real names; examples use *.tfvars.example
*.tfvars
*.tfvars.json
!*.tfvars.example
# Generated inputs: domains (scripts/publish-domains.sh), plane_attachment and others
*.auto.tfvars.json

# Local overrides (for example a module source pointing to a local checkout)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Crash logs and CLI configuration
crash.log
crash.*.log
.terraformrc
terraform.rc

# Python and editors
__pycache__/
.*.sw*
.idea/
.vscode/

# Node image build: local variables and work directory
images/kubernetes-node/build.json
images/kubernetes-node/.work/
# Interrupted domain publication (scripts/publish-domains.sh)
stacks/shared/entry-point/.domains-publication-pending
# Test campaign: local configuration, outputs and recordings
tests/campaign/campaign.env
tests/campaign/work/
