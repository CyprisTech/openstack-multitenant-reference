# Local .terraform directories and lock files
.terraform/
.terraform.lock.hcl

# State and plan files: never commit them, they contain secrets and infrastructure details
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.json

# Variable files may contain secrets and real names; examples use *.tfvars.example
*.tfvars
*.tfvars.json
!*.tfvars.example
# Generated routes (stack 30 web output, read by stack 20)
*.auto.tfvars.json

# Local overrides (for example a module source pointing to a local checkout)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Crash logs and CLI configuration
crash.log
crash.*.log
.terraformrc
terraform.rc

# Python and editors
__pycache__/
.*.sw*
.idea/
.vscode/

# Node image build: local variables and work directory
images/kubernetes-node/build.json
images/kubernetes-node/.work/
# Interrupted route publication (scripts/publish-routes.sh)
stacks/20-public-edge/.routes-publication-pending
