#!/usr/bin/env bash
# Create the cluster from the bootstrap instance (ADR-0002, D3). Run as root, after
# copying a clouds.yaml with an entry "openstack" for the project of the cluster to
# /opt/platform/clouds.yaml (application credential scoped to the project), and, when the
# cloud API uses a private certificate authority, its certificates to /opt/platform/cacert.pem.
# The script can be run again: each step skips what already exists.
set -euo pipefail
cd /opt/platform

export KUBECONFIG=/opt/platform/bootstrap.kubeconfig
workload=/opt/platform/${cluster.name}.kubeconfig

# clusterctl init --wait-providers returns once the controllers run, but their webhooks may still
# refuse connections for a few seconds: wait until the API server validates the manifests.
wait_webhooks() {
  for _ in $(seq 30); do kubectl apply --dry-run=server "$@" >/dev/null 2>&1 && return 0; sleep 10; done
  kubectl apply --dry-run=server "$@"
}

# namespace [kubectl options] NAME: creates the namespace unless it exists. CAAPH may create the
# namespace of a chart at the same moment: a create that finds it already there is not an error.
namespace() {
  local name="$${@: -1}" options=("$${@:1:$#-1}")
  kubectl "$${options[@]}" get namespace "$name" >/dev/null 2>&1 && return 0
  kubectl "$${options[@]}" create namespace "$name" 2>/dev/null || kubectl "$${options[@]}" get namespace "$name" >/dev/null
}

[[ -f clouds.yaml ]] || { echo "copy clouds.yaml (entry \"openstack\") to /opt/platform first" >&2; exit 1; }

# A run after clusterctl move (an earlier run stopped later): the cluster manages itself, the kind
# cluster is empty or gone. The remaining steps then run against the cluster itself; a new kind
# cluster would create a second Cluster object for the same OpenStack resources.
moved=false
if [[ -s "$workload" ]] && kubectl --kubeconfig "$workload" --request-timeout=15s -n platform get cluster/${cluster.name} >/dev/null 2>&1; then
  moved=true
  export KUBECONFIG="$workload"
  echo "Cluster ${cluster.name} already manages itself: the steps after the move run again."
elif [[ -s "$workload" ]] && ! kind get clusters | grep -qx bootstrap; then
  echo "kind cluster gone and ${cluster.name} not reachable from here: the cluster was moved, do not create it again" >&2
  exit 1
fi

# 1. Management cluster in kind, with Cluster API, CAPO, ORC and CAAPH.
export CLUSTER_TOPOLOGY=true
if ! $moved; then
  kind get clusters | grep -qx bootstrap || kind create cluster --name bootstrap --kubeconfig "$KUBECONFIG"
  kubectl apply --server-side -f https://github.com/k-orc/openstack-resource-controller/releases/download/${versions.orc}/install.yaml
  # ORC objects must follow the Cluster API objects on clusterctl move.
  kubectl get crd -o name | grep k-orc.cloud | xargs -I{} kubectl label --overwrite {} clusterctl.cluster.x-k8s.io/move=
  kubectl get namespace capo-system >/dev/null 2>&1 || clusterctl init --core cluster-api:${versions.cluster_api} --bootstrap kubeadm:${versions.cluster_api} \
    --control-plane kubeadm:${versions.cluster_api} --infrastructure openstack:${versions.capo} --addon helm:${versions.caaph} --wait-providers
fi

# 2. Credentials, cluster class, add-ons and cluster.
namespace platform
ca_args=()
[[ -f cacert.pem ]] && ca_args=(--from-file=cacert=cacert.pem)
kubectl -n platform create secret generic ${prefix}-cloud-config --from-file=clouds.yaml "$${ca_args[@]}" \
  --dry-run=client -o yaml | kubectl label --local -f - clusterctl.cluster.x-k8s.io/move= -o yaml | kubectl apply -f -
wait_webhooks -f manifests/cluster-class.yaml -f manifests/addons.yaml
kubectl apply -f manifests/cluster-class.yaml -f manifests/addons.yaml
# The address of this bootstrap instance, admitted on the API while it manages the cluster.
source=$(./bootstrap-source)
sed "s|BOOTSTRAP_SOURCE|$source|" manifests/cluster.yaml | kubectl apply -f -
# By its value: once true, Cluster API no longer updates the observedGeneration of this condition,
# and kubectl wait --for=condition would never return on a cluster changed since (a script run again).
kubectl -n platform wait cluster/${cluster.name} --for=jsonpath='{.status.conditions[?(@.type=="ControlPlaneInitialized")].status}'=True --timeout=30m
$moved || clusterctl -n platform get kubeconfig ${cluster.name} > "$workload"

# 3. Objects of the workload cluster that are not Helm charts: the cloud configuration of the
#    cloud controller manager and Cinder CSI, the right of the cloud controller to delete nodes,
#    the default storage class, the Gateway API CRDs, and, in demonstration mode (without
#    certificates), a self-signed certificate.
cloud_conf=$(./cloud-conf)
kubectl --kubeconfig "$workload" -n kube-system create secret generic cloud-config \
  --from-literal=cloud.conf="$cloud_conf" $([[ -f cacert.pem ]] && echo --from-file=ca.crt=cacert.pem) --dry-run=client -o yaml | kubectl --kubeconfig "$workload" apply -f -
kubectl --kubeconfig "$workload" apply -f manifests/node-deletion.yaml -f manifests/storage-class.yaml
kubectl --kubeconfig "$workload" apply --server-side -f https://github.com/kubernetes-sigs/gateway-api/releases/download/${versions.gateway_api}/standard-install.yaml
%{ for name, i in ingresses ~}
namespace --kubeconfig "$workload" ${i.namespace}
%{ if certificates == null ~}
if ! kubectl --kubeconfig "$workload" -n ${i.namespace} get secret ${i.tls_secret} >/dev/null 2>&1; then
  openssl req -x509 -newkey rsa:2048 -nodes -days 90 -subj "/CN=${i.domains[0]}" \
    -addext "subjectAltName=${join(",", [for d in i.domains : "DNS:${d}"])}" -keyout /tmp/tls.key -out /tmp/tls.crt
  kubectl --kubeconfig "$workload" -n ${i.namespace} create secret tls ${i.tls_secret} --cert=/tmp/tls.crt --key=/tmp/tls.key
  rm -f /tmp/tls.key /tmp/tls.crt
fi
%{ endif ~}
%{ endfor ~}
%{ if length(services) > 0 ~}
kubectl --kubeconfig "$workload" apply -f manifests/services.yaml
%{ endif ~}

kubectl -n platform wait cluster/${cluster.name} --for=jsonpath='{.status.conditions[?(@.type=="Available")].status}'=True --timeout=30m
# clusterctl move refuses to run while a machine is still provisioning.
kubectl -n platform wait kubeadmcontrolplane -l cluster.x-k8s.io/cluster-name=${cluster.name} \
  --for=jsonpath='{.status.readyReplicas}'=${cluster.control_plane_count} --timeout=40m
kubectl -n platform wait machinedeployment -l cluster.x-k8s.io/cluster-name=${cluster.name} \
  --for=jsonpath='{.status.readyReplicas}'=${cluster.worker_count} --timeout=30m
kubectl -n platform wait machine -l cluster.x-k8s.io/cluster-name=${cluster.name} --for=jsonpath='{.status.phase}'=Running --timeout=30m
kubectl --kubeconfig "$workload" wait nodes --all --for=condition=Ready --timeout=20m

# 4. Self-management: Cluster API moves into the workload cluster.
kubectl --kubeconfig "$workload" get namespace capo-system >/dev/null 2>&1 || clusterctl init --kubeconfig "$workload" --core cluster-api:${versions.cluster_api} --bootstrap kubeadm:${versions.cluster_api} \
  --control-plane kubeadm:${versions.cluster_api} --infrastructure openstack:${versions.capo} --addon helm:${versions.caaph} --wait-providers
kubectl --kubeconfig "$workload" apply --server-side -f https://github.com/k-orc/openstack-resource-controller/releases/download/${versions.orc}/install.yaml
# The manifests are validated in the namespace they are moved to.
namespace --kubeconfig "$workload" platform
wait_webhooks --kubeconfig "$workload" -f manifests/cluster-class.yaml -f manifests/addons.yaml
$moved || clusterctl move -n platform --to-kubeconfig "$workload"
# clusterctl move does not carry the ORC Image: declare it again in the workload cluster.
python3 -c 'import sys, yaml; print(yaml.safe_dump_all([d for d in yaml.safe_load_all(open("manifests/cluster-class.yaml")) if d and d["kind"] == "Image"]))' \
  | kubectl --kubeconfig "$workload" apply -f -
%{ if certificates != null ~}
# 5. Certificates of the domains (ADR-0008), once cert-manager runs in the workload cluster,
#    while the bootstrap instance may still reach the API.
%{ if length(certificates.dns.resolvers) > 0 ~}
#    cert-manager checks the TXT record on the given name servers only.
args=$(kubectl --kubeconfig "$workload" -n cert-manager get deployment cert-manager -o jsonpath='{.spec.template.spec.containers[0].args}')
if [[ "$args" != *dns01-recursive-nameservers-only* ]]; then
  kubectl --kubeconfig "$workload" -n cert-manager patch deployment cert-manager --type=json -p '[
    {"op": "add", "path": "/spec/template/spec/containers/0/args/-", "value": "--dns01-recursive-nameservers-only"},
    {"op": "add", "path": "/spec/template/spec/containers/0/args/-", "value": "--dns01-recursive-nameservers=${join(",", certificates.dns.resolvers)}"}]'
  kubectl --kubeconfig "$workload" -n cert-manager rollout status deployment cert-manager --timeout=5m
fi
%{ endif ~}
kubectl --kubeconfig "$workload" wait --for=condition=Available -n cert-manager deployment --all --timeout=10m
kubectl --kubeconfig "$workload" apply -f manifests/certificates.yaml
%{ for name, i in ingresses ~}
kubectl --kubeconfig "$workload" -n ${i.namespace} wait certificate/${i.tls_secret} --for=condition=Ready --timeout=15m
%{ endfor ~}
%{ endif ~}

kind delete cluster --name bootstrap
# One release proxy per chart. CAAPH before v0.6.6 could create a second one after the move, when
# its cache lagged behind its own write (kubernetes-sigs/cluster-api-addon-provider-helm#606); a
# duplicate blocks every later change of the add-ons. Checked while the bootstrap instance still
# reaches the API.
duplicates=$(kubectl --kubeconfig "$workload" --request-timeout=15s -n platform get helmreleaseproxy \
  -o jsonpath='{range .items[*]}{.spec.namespace}/{.spec.releaseName}{"\n"}{end}' | sort | uniq -d)
[[ -z "$duplicates" ]] || { echo "duplicate Helm release proxies after the move: $duplicates" >&2; exit 1; }

# The bootstrap instance no longer manages the cluster: its address leaves the API sources. Last,
# since it no longer reaches the API afterwards. The add-ons do not depend on the API sources.
sed 's|, *"BOOTSTRAP_SOURCE"||' manifests/cluster.yaml | kubectl --kubeconfig "$workload" apply -f -

echo "Cluster ${cluster.name} manages itself. Kubeconfig: $workload"
