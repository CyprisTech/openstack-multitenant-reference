#!/usr/bin/env bash
# Delete the cluster (ADR-0002, D3): move Cluster API back to a kind cluster on the
# bootstrap instance, delete the Cluster, wait for its servers and load balancers to go, then
# destroy the stack. Run as root with the kubeconfig of the workload cluster in place.
set -euo pipefail
cd /opt/platform

export KUBECONFIG=/opt/platform/bootstrap.kubeconfig
workload=/opt/platform/${cluster.name}.kubeconfig

# A creation that stopped before clusterctl move leaves Cluster API on the kind cluster of this
# instance: the cluster is then deleted from here, without moving anything.
not_moved=""
if kind get clusters 2>/dev/null | grep -qx bootstrap && kubectl -n platform get cluster ${cluster.name} >/dev/null 2>&1; then
  not_moved=yes
  echo "Cluster ${cluster.name} is still managed by this bootstrap instance (not moved): deleting it from here."
elif [[ ! -f "$workload" ]]; then
  echo "No cluster ${cluster.name} here and no kubeconfig of it: nothing to delete."
  exit 0
fi

# After clusterctl move, the bootstrap instance is no longer admitted on the API (create-cluster.sh
# removes its address). It cannot admit itself: an operator must do it from an administration
# source, then run this script again.
if [[ -z "$not_moved" ]] && ! kubectl --kubeconfig "$workload" --request-timeout=15s get --raw /healthz >/dev/null 2>&1; then
  echo "The Kubernetes API does not admit this instance. From an administration source, with the" >&2
  echo "stack's files (scripts/cluster-files.sh), run:" >&2
  echo "  KUBECONFIG=<cluster kubeconfig> <directory>/update-cluster.sh --admit $(./bootstrap-source)" >&2
  echo "wait about a minute, then run this script again." >&2
  exit 1
fi

# Load balancers created by the cloud controller manager belong to Services: delete them first,
# while the cloud controller manager still runs.
# Before a move, the workload API may be unreachable: the cloud controller's load balancers are
# then removed with the cluster's network objects by Cluster API, or left for the operator.
if kubectl --kubeconfig "$workload" --request-timeout=15s get --raw /healthz >/dev/null 2>&1; then
  kubectl --kubeconfig "$workload" delete service -A --field-selector spec.type=LoadBalancer --wait=true
  # The volumes of the persistent volume claims belong to Cinder CSI: deleted the same way, or they
  # stay in the project. StatefulSets first: they would recreate a claim with their pod. A claim
  # is deleted once no pod mounts it: the pods that mount one go too.
  kubectl --kubeconfig "$workload" delete statefulset -A --all --wait=true
  kubectl --kubeconfig "$workload" delete pvc -A --all --wait=false
  kubectl --kubeconfig "$workload" get pods -A -o json \
    | jq -r '.items[] | select(any(.spec.volumes[]?; .persistentVolumeClaim)) | "\(.metadata.namespace) \(.metadata.name)"' \
    | while read -r ns pod; do kubectl --kubeconfig "$workload" -n "$ns" delete pod "$pod" --wait=false; done
  # Until no volume with the reclaim policy Delete is left, read again each time: a claim created
  # meanwhile has its own.
  for _ in $(seq 60); do
    volumes=$(kubectl --kubeconfig "$workload" get pv -o json \
      | jq -r '.items[] | select(.spec.persistentVolumeReclaimPolicy == "Delete") | .metadata.name')
    [[ -z "$volumes" ]] && break
    kubectl --kubeconfig "$workload" delete pvc -A --all --wait=false >/dev/null
    sleep 10
  done
  [[ -z "$volumes" ]] || echo "Volumes still there after 10 minutes ($volumes): check for leftover volumes in the project." >&2
else
  echo "The workload API does not answer: its LoadBalancer Services and volumes are not deleted first; check for leftover load balancers and volumes." >&2
fi

# The operator admitted this instance with a patch of the API sources (variable 0), not by
# applying manifests/cluster.yaml again: after an upgrade, its version and image are older than
# the cluster's.

if [[ -z "$not_moved" ]]; then
  # A kind cluster left by an earlier run, with providers of another release: clusterctl move
  # refuses a target older than the source. It holds nothing (the cluster manages itself): recreate it.
  wanted="cluster-api:${versions.cluster_api} kubeadm:${versions.cluster_api} openstack:${versions.capo} helm:${versions.caaph}"
  if kind get clusters | grep -qx bootstrap && kubectl get namespace capo-system >/dev/null 2>&1; then
    installed=$(kubectl get providers -A -o jsonpath='{range .items[*]}{.providerName}:{.version} {end}')
    for p in $wanted; do
      grep -qw -- "$p" <<<"$installed" || { echo "kind cluster with other providers ($installed): recreated"; kind delete cluster --name bootstrap; break; }
    done
  fi
  kind get clusters | grep -qx bootstrap || kind create cluster --name bootstrap --kubeconfig "$KUBECONFIG"
  kubectl apply --server-side -f https://github.com/k-orc/openstack-resource-controller/releases/download/${versions.orc}/install.yaml
  kubectl get crd -o name | grep k-orc.cloud | xargs -I{} kubectl label --overwrite {} clusterctl.cluster.x-k8s.io/move=
  export CLUSTER_TOPOLOGY=true
  kubectl get namespace capo-system >/dev/null 2>&1 || clusterctl init --core cluster-api:${versions.cluster_api} --bootstrap kubeadm:${versions.cluster_api} \
    --control-plane kubeadm:${versions.cluster_api} --infrastructure openstack:${versions.capo} --addon helm:${versions.caaph} --wait-providers
  clusterctl move -n platform --kubeconfig "$workload" --to-kubeconfig "$KUBECONFIG"
fi

# clusterctl move does not carry the ORC Image: declare it again, or CAPO waits for it and the
# machines are never deleted.
python3 -c 'import sys, yaml; print(yaml.safe_dump_all([d for d in yaml.safe_load_all(open("manifests/cluster-class.yaml")) if d and d["kind"] == "Image"]))' \
  | kubectl apply -f -

kubectl -n platform delete cluster ${cluster.name} --wait=false
# Wait for the Cluster to go. If the KubeadmControlPlane is deleted before its machines, the
# pre-terminate hook it owns is never removed and the machines wait forever: remove it then.
for _ in $(seq 1 120); do
  kubectl -n platform get cluster ${cluster.name} >/dev/null 2>&1 || break
  if ! kubectl -n platform get kubeadmcontrolplane -o name 2>/dev/null | grep -q .; then
    for m in $(kubectl -n platform get machines -o name 2>/dev/null); do
      kubectl -n platform annotate "$m" pre-terminate.delete.hook.machine.cluster.x-k8s.io/kcp-cleanup- >/dev/null 2>&1 || true
    done
  fi
  sleep 15
done
if kubectl -n platform get cluster ${cluster.name} >/dev/null 2>&1; then
  echo "Cluster ${cluster.name} still present after 30 minutes: check kubectl -n platform get machines,openstackmachines" >&2
  exit 1
fi
kind delete cluster --name bootstrap
# The kubeconfig of a deleted cluster: run again, the script finds nothing to delete.
rm -f "$workload"
echo "Cluster ${cluster.name} deleted: destroy the stack now."
