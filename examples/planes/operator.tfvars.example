# stacks/shared/planes on a private or sovereign cloud whose operator provides the planes as
# external networks: they are adopted, nothing is created. Any project's credentials can read
# them; the shared services project is a natural choice.
cloud = "shared-services"
site  = "site-a"

# cidr: the range reached through the plane (it may be wider than the plane's own subnet).
planes = {
  publication   = { mode = "gateway", cidr = "198.51.100.0/24", network = "svc_public", subnet = "svc_public" }
  observability = { mode = "gateway", cidr = "203.0.113.0/24", network = "monitoring", subnet = "monitoring" }
  internal      = { mode = "gateway", cidr = "192.0.2.0/24", network = "intranet", subnet = "intranet" }
}

# Every project joining the planes, with its role on each one. On operator planes, tenant ranges
# may overlap: tenants are seen through floating IPs of the planes.
attachments = {
  edge             = { project_id = "<entry point project>", cidr = "10.20.0.0/24", planes = { publication = "shared", observability = "tenant" } }
  receiver         = { project_id = "<shared services project>", cidr = "10.34.0.0/28", planes = { observability = "shared" } }
  internal-service = { project_id = "<shared services project>", cidr = "10.35.0.0/28", planes = { internal = "shared" } }
  acme             = { project_id = "<shared services project>", cidr = "10.37.0.0/28", planes = { internal = "shared" } }
  web              = { project_id = "<web project>", cidr = "10.21.0.0/24", planes = { publication = "tenant", observability = "tenant", internal = "tenant" } }
  isolated         = { project_id = "<isolated project>", cidr = "10.22.0.0/24", planes = { observability = "tenant" } }
  platform         = { project_id = "<kubernetes project>", cidr = "10.24.0.0/24", planes = { publication = "tenant", observability = "tenant", internal = "tenant" } }
  k8s-shared       = { project_id = "<shared services cluster project>", cidr = "10.36.0.0/24", planes = { internal = "shared", observability = "tenant" } }
}
