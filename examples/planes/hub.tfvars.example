# stacks/shared/planes on a public cloud: the planes are private networks of the hub project,
# shared with the attached projects by RBAC and joined through a transit router. A member role is
# enough. Applied with the hub project's credentials; the hub holds the network only.
cloud = "hub"
site  = "site-a"

planes = {
  publication   = { mode = "interface", cidr = "172.31.0.0/24", mtu = 1362 }
  observability = { mode = "interface", cidr = "172.31.1.0/24", mtu = 1362 }
  internal      = { mode = "interface", cidr = "172.31.2.0/24", mtu = 1362 }
}

# Every project joining the planes, with its role on each one. On hub planes, ranges must
# not overlap: tenants are seen at their own addresses.
# The Kubernetes tenant joins the internal services plane; as this plane gives no floating IPs, its stack needs
# admin_network, an external network for the API and bootstrap floating IPs.
attachments = {
  edge             = { project_id = "<entry point project>", cidr = "10.20.0.0/24", planes = { publication = "shared", observability = "tenant" } }
  receiver         = { project_id = "<shared services project>", cidr = "10.34.0.0/28", planes = { observability = "shared" } }
  internal-service = { project_id = "<shared services project>", cidr = "10.35.0.0/28", planes = { internal = "shared" } }
  acme             = { project_id = "<shared services project>", cidr = "10.37.0.0/28", planes = { internal = "shared" } }
  web              = { project_id = "<web project>", cidr = "10.21.0.0/24", planes = { publication = "tenant", observability = "tenant", internal = "tenant" } }
  isolated         = { project_id = "<isolated project>", cidr = "10.22.0.0/24", planes = { observability = "tenant" } }
  platform         = { project_id = "<kubernetes project>", cidr = "10.24.0.0/24", planes = { publication = "tenant", observability = "tenant", internal = "tenant" } }
  k8s-shared       = { project_id = "<shared services cluster project>", cidr = "10.36.0.0/24", planes = { internal = "shared", observability = "tenant" } }
}

# The shared services route these aggregates: a new tenant inside them changes no shared service.
tenant_ranges = {
  publication   = ["10.21.0.0/16", "10.22.0.0/15", "10.24.0.0/14"]
  observability = ["10.20.0.0/14", "10.24.0.0/14", "10.36.0.0/24"]
  internal      = ["10.20.0.0/14", "10.24.0.0/14"]
}
