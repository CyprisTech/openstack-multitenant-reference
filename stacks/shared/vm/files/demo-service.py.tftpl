#!/usr/bin/env python3
"""Demonstration workload of a shared service: answers on each port of the services with the name
of the service and of the instance, over HTTPS when the instance has a certificate, HTTP otherwise."""

import http.server
import os
import ssl
import threading

PORTS = ${jsonencode(ports)}  # port => name of its service
INSTANCE = "${instance}"
CERT, KEY = "/etc/shared-service/tls/cert.pem", "/etc/shared-service/tls/key.pem"


class Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        body = f"{PORTS[str(self.server.server_address[1])]} {INSTANCE}\n".encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)


def serve(port):
    server = http.server.ThreadingHTTPServer(("", port), Handler)
    if os.path.exists(CERT) and os.path.exists(KEY):
        context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        context.load_cert_chain(CERT, KEY)
        server.socket = context.wrap_socket(server.socket, server_side=True)
    server.serve_forever()


threads = [threading.Thread(target=serve, args=(int(port),)) for port in PORTS]
for thread in threads:
    thread.start()
for thread in threads:
    thread.join()
