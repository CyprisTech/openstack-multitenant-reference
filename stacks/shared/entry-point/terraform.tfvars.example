# Copy to terraform.tfvars (git-ignored) and adapt to your cloud.
cloud = "example-site-a"
site  = "site-a"
az    = "nova"
image = "ubuntu-24.04"

flavor           = "m1.small"
boot_volume_size = 10 # null with a flavor that has a local disk

public_network = { network = "public", subnet = "public-subnet" }


dns_nameservers   = ["192.0.2.53"]
network_mtu       = 1362 # smallest of the tenant overlay MTU and the plane MTUs
octavia_flavor_id = null # an active/standby flavor if the cloud offers one

domains = {
  "site-a.example.org" = { backends = ["198.51.100.21:443", "198.51.100.22:443"] }
  "site-b.example.org" = { backends = ["198.51.100.21:443", "198.51.100.22:443"] }
}

admin = {
  users     = { ops = ["ssh-ed25519 AAAA... ops@example.org"] }
  ssh_cidrs = ["192.0.2.0/24"]
}

public_dns = { zone = "example.org.", names = ["", "www"], ttl = 300 }

# Optional bastion with a floating IP on an administration network; with it, admin.ssh_cidrs
# can stay empty.
bastion = {
  external_network = { network = "intranet", subnet = "intranet" }
  ssh_cidrs        = ["192.0.2.0/24"]
}

# Metrics pushed to the receiver of the shared services (output receiver_url of the receiver).
monitoring = { receiver = "http://203.0.113.10:9090" }

# How this stack joins the planes: its entry of the attachments output of stack shared/planes,
# whether the planes are the operator's or built in a hub project. For example:
#   tofu -chdir=../../shared/planes output -json attachments | jq '{plane_attachment: .edge.planes}' > planes.auto.tfvars.json
