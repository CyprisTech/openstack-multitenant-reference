#!/usr/bin/env bash
# Create the platform cluster from the bootstrap instance (ADR-0002, D3). Run as root, after
# copying a clouds.yaml with an entry "openstack" for the platform project to
# /opt/platform/clouds.yaml (application credential scoped to the project).
set -euo pipefail
cd /opt/platform

export KUBECONFIG=/opt/platform/bootstrap.kubeconfig
workload=/opt/platform/${cluster.name}.kubeconfig
[[ -f clouds.yaml ]] || { echo "copy clouds.yaml (entry \"openstack\") to /opt/platform first" >&2; exit 1; }

# 1. Management cluster in kind, with Cluster API, CAPO, ORC and CAAPH.
kind get clusters | grep -qx bootstrap || kind create cluster --name bootstrap --kubeconfig "$KUBECONFIG"
kubectl apply --server-side -f https://github.com/k-orc/openstack-resource-controller/releases/download/${versions.orc}/install.yaml
# ORC objects must follow the Cluster API objects on clusterctl move.
kubectl get crd -o name | grep k-orc.cloud | xargs -I{} kubectl label --overwrite {} clusterctl.cluster.x-k8s.io/move=
export CLUSTER_TOPOLOGY=true
clusterctl init --core cluster-api:${versions.cluster_api} --bootstrap kubeadm:${versions.cluster_api} \
  --control-plane kubeadm:${versions.cluster_api} --infrastructure openstack:${versions.capo} --addon helm:${versions.caaph} --wait-providers

# 2. Credentials, cluster class, add-ons and cluster.
kubectl create namespace platform --dry-run=client -o yaml | kubectl apply -f -
kubectl -n platform create secret generic ${prefix}-cloud-config --from-file=clouds.yaml \
  --dry-run=client -o yaml | kubectl label --local -f - clusterctl.cluster.x-k8s.io/move= -o yaml | kubectl apply -f -
kubectl apply -f manifests/cluster-class.yaml -f manifests/addons.yaml
kubectl apply -f manifests/cluster.yaml
kubectl -n platform wait cluster/${cluster.name} --for=condition=ControlPlaneInitialized --timeout=30m
clusterctl -n platform get kubeconfig ${cluster.name} > "$workload"

# 3. Objects of the workload cluster that are not Helm charts: the cloud configuration of the
#    cloud controller manager and Cinder CSI, the Gateway API CRDs, the demonstration certificate.
cloud_conf=$(python3 - <<'EOF'
import yaml
c = yaml.safe_load(open("/opt/platform/clouds.yaml"))["clouds"]["openstack"]
a = c["auth"]
print("[Global]")
print(f"auth-url={a['auth_url']}")
if "application_credential_id" in a:
    print(f"application-credential-id={a['application_credential_id']}")
    print(f"application-credential-secret={a['application_credential_secret']}")
print(f"region={c.get('region_name', 'RegionOne')}")
print("[LoadBalancer]")
print("create-monitor=true")
EOF
)
kubectl --kubeconfig "$workload" -n kube-system create secret generic cloud-config \
  --from-literal=cloud.conf="$cloud_conf" --dry-run=client -o yaml | kubectl --kubeconfig "$workload" apply -f -
kubectl --kubeconfig "$workload" apply --server-side -f https://github.com/kubernetes-sigs/gateway-api/releases/download/${versions.gateway_api}/standard-install.yaml
kubectl --kubeconfig "$workload" create namespace traefik --dry-run=client -o yaml | kubectl --kubeconfig "$workload" apply -f -
if ! kubectl --kubeconfig "$workload" -n traefik get secret platform-tls >/dev/null 2>&1; then
  openssl req -x509 -newkey rsa:2048 -nodes -days 90 -subj "/CN=${cluster.domains[0]}" \
    -addext "subjectAltName=${join(",", [for d in cluster.domains : "DNS:${d}"])}" -keyout /tmp/tls.key -out /tmp/tls.crt
  kubectl --kubeconfig "$workload" -n traefik create secret tls platform-tls --cert=/tmp/tls.crt --key=/tmp/tls.key
  rm -f /tmp/tls.key /tmp/tls.crt
fi

kubectl -n platform wait cluster/${cluster.name} --for=condition=Available --timeout=30m
kubectl --kubeconfig "$workload" wait nodes --all --for=condition=Ready --timeout=20m

# 4. Self-management: Cluster API moves into the workload cluster.
clusterctl init --kubeconfig "$workload" --core cluster-api:${versions.cluster_api} --bootstrap kubeadm:${versions.cluster_api} \
  --control-plane kubeadm:${versions.cluster_api} --infrastructure openstack:${versions.capo} --addon helm:${versions.caaph} --wait-providers
kubectl --kubeconfig "$workload" apply --server-side -f https://github.com/k-orc/openstack-resource-controller/releases/download/${versions.orc}/install.yaml
clusterctl move -n platform --to-kubeconfig "$workload"
kind delete cluster --name bootstrap

echo "Cluster ${cluster.name} manages itself. Kubeconfig: $workload"
